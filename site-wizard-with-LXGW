// ==UserScript==
// @name         AO3: Site Wizard (with LXGW WenKai Screen CDN) - Personal Edition
// @namespace    http://tampermonkey.net/
// @version      1.8.5
// @description  Customize AO3 reading styles, typography, cleanup extra line breaks/empty paragraphs, and provide a touch-friendly settings panel.
// @author       BlackBatCat (Modified)
// @match        *://archiveofourown.org/*
// @match        *://*.archiveofourown.org/*
// @grant        GM_addStyle
// @grant        GM_getValue
// @grant        GM_setValue
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // ============================================================
    // 1. 外部字体
    // ============================================================

    const cdnFontCss = `
        @import url('https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-web@latest/style.css');
    `;

    GM_addStyle(cdnFontCss);


    // ============================================================
    // 2. 默认配置
    // ============================================================

    const SETTINGS_KEY = 'ao3_site_wizard_settings';

    const DEFAULT_SETTINGS = {
        enabled: true,

        siteFont:
            '"LXGW WenKai GB Screen", "LXGW WenKai Screen", serif',

        workFont:
            '"LXGW WenKai GB Screen", "LXGW WenKai Screen", serif',

        fontSize: '115%',
        lineHeight: '1.7',
        maxWidth: '42em',
        letterSpacing: '0.02em',
        paragraphSpacing: '0.8em',

        enableIndent: false,
        cleanBreaks: true,
        justifyText: true,
        highContrast: true,
        hideNotes: false
    };


    // ============================================================
    // 3. GM Storage
    // ============================================================

    /*
     * 设置优先保存在 userscript manager 的 GM Storage 中。
     *
     * 第一次升级到 v1.8.5 时：
     *
     * localStorage
     *      ↓
     * GM Storage
     *
     * 自动迁移旧版本配置。
     */

    function getSettings() {
        let saved = GM_getValue(
            SETTINGS_KEY,
            null
        );

        // --------------------------------------------------------
        // 已经存在 GM Storage 配置
        // --------------------------------------------------------

        if (
            saved &&
            typeof saved === 'object' &&
            !Array.isArray(saved)
        ) {
            return {
                ...DEFAULT_SETTINGS,
                ...saved
            };
        }


        // --------------------------------------------------------
        // 尝试迁移旧 localStorage 配置
        // --------------------------------------------------------

        try {
            const legacy =
                localStorage.getItem(
                    SETTINGS_KEY
                );

            if (legacy) {
                const parsed =
                    JSON.parse(legacy);

                if (
                    parsed &&
                    typeof parsed === 'object' &&
                    !Array.isArray(parsed)
                ) {
                    GM_setValue(
                        SETTINGS_KEY,
                        parsed
                    );

                    localStorage.removeItem(
                        SETTINGS_KEY
                    );

                    console.info(
                        '[AO3 Site Wizard] Settings migrated from localStorage to GM Storage.'
                    );

                    return {
                        ...DEFAULT_SETTINGS,
                        ...parsed
                    };
                }
            }
        } catch (error) {
            console.warn(
                '[AO3 Site Wizard] Failed to migrate legacy settings:',
                error
            );
        }


        // --------------------------------------------------------
        // 没有任何已有配置
        // --------------------------------------------------------

        return {
            ...DEFAULT_SETTINGS
        };
    }


    function saveSettings(settings) {
        GM_setValue(
            SETTINGS_KEY,
            settings
        );
    }


    // ============================================================
    // 4. 空白判断
    // ============================================================

    /*
     * 清理：
     *
     * 普通 whitespace
     * &nbsp;                  \u00A0
     * 全角空格                \u3000
     * zero-width characters
     * word joiner
     * BOM
     * Unicode 特殊空白
     */

    function isBlankText(text) {
        return String(text || '')
            .replace(
                /[\s\u00A0\u1680\u180E\u2000-\u200F\u2028\u2029\u202F\u205F\u2060\u3000\uFEFF]/g,
                ''
            )
            .trim() === '';
    }


    // ============================================================
    // 5. 判断 HTML 元素是否为空
    // ============================================================

    function isEmptyElement(el) {
        if (!el) {
            return true;
        }

        /*
         * 有实际视觉 / 嵌入内容时保留。
         *
         * 防止例如：
         *
         * <p><img ...></p>
         *
         * 因 textContent 为空而被误删。
         */

        if (
            el.querySelector(
                'img, iframe, video, audio, canvas, svg, object, embed'
            )
        ) {
            return false;
        }

        return isBlankText(
            el.textContent
        );
    }


    // ============================================================
    // 6. 正文空行清理
    // ============================================================

    function cleanExtraBreaks() {
        const settings =
            getSettings();

        if (
            !settings.enabled ||
            !settings.cleanBreaks
        ) {
            return;
        }


        /*
         * 一个 AO3 页面可能有多个 .userstuff，
         * 所以不能只 querySelector 第一个。
         */

        const userstuffs =
            document.querySelectorAll(
                '#workskin .userstuff'
            );

        if (!userstuffs.length) {
            return;
        }


        userstuffs.forEach(
            userstuff => {

                // =================================================
                // A. 优先清理 ace-line 伪空行
                // =================================================

                /*
                 * 例如：
                 *
                 * <div class="ace-line longKeep gutter-noauthor">
                 *     <p>
                 *         <span>&nbsp;</span>
                 *     </p>
                 * </div>
                 */

                userstuff
                    .querySelectorAll(
                        'div.ace-line'
                    )
                    .forEach(
                        div => {
                            if (
                                isEmptyElement(div)
                            ) {
                                div.remove();
                            }
                        }
                    );


                // =================================================
                // B. 清理空 inline 元素
                // =================================================

                userstuff
                    .querySelectorAll(
                        'span, em, strong, b, i'
                    )
                    .forEach(
                        el => {
                            if (
                                isEmptyElement(el)
                            ) {
                                el.remove();
                            }
                        }
                    );


                // =================================================
                // C. 清理空链接
                // =================================================

                userstuff
                    .querySelectorAll('a')
                    .forEach(
                        el => {
                            if (
                                isEmptyElement(el)
                            ) {
                                el.remove();
                            }
                        }
                    );


                // =================================================
                // D. 清理空段落
                // =================================================

                userstuff
                    .querySelectorAll('p')
                    .forEach(
                        p => {
                            if (
                                isEmptyElement(p)
                            ) {
                                p.remove();
                            }
                        }
                    );


                // =================================================
                // E. 再次清理 ace-line
                // =================================================

                /*
                 * 因为上面删除 span / p 后，
                 * 外层 div 可能刚刚才变为空。
                 */

                userstuff
                    .querySelectorAll(
                        'div.ace-line'
                    )
                    .forEach(
                        div => {
                            if (
                                isEmptyElement(div)
                            ) {
                                div.remove();
                            }
                        }
                    );


                // =================================================
                // F. 清理普通空 div
                // =================================================

                userstuff
                    .querySelectorAll('div')
                    .forEach(
                        div => {
                            if (
                                isEmptyElement(div)
                            ) {
                                div.remove();
                            }
                        }
                    );


                // =================================================
                // G. 清理连续 BR
                // =================================================

                const brs =
                    Array.from(
                        userstuff.querySelectorAll(
                            'br'
                        )
                    );


                brs.forEach(
                    br => {

                        if (
                            !br.isConnected
                        ) {
                            return;
                        }

                        let next =
                            br.nextSibling;


                        /*
                         * 跳过 BR 中间的纯空白文本节点。
                         */

                        while (
                            next &&
                            next.nodeType === Node.TEXT_NODE &&
                            isBlankText(
                                next.nodeValue
                            )
                        ) {
                            next =
                                next.nextSibling;
                        }


                        /*
                         * <br> whitespace <br>
                         *
                         * 删除前面的 BR。
                         */

                        if (
                            next &&
                            next.nodeType === Node.ELEMENT_NODE &&
                            next.tagName === 'BR'
                        ) {
                            br.remove();
                        }
                    }
                );


                // =================================================
                // H. 最后一轮兜底
                // =================================================

                userstuff
                    .querySelectorAll(
                        'p, div.ace-line'
                    )
                    .forEach(
                        el => {
                            if (
                                isEmptyElement(el)
                            ) {
                                el.remove();
                            }
                        }
                    );
            }
        );
    }


    // ============================================================
    // 7. MutationObserver
    // ============================================================

    let workObserver = null;
    let cleanTimer = null;


    function observeWorkContent() {
        const workskin =
            document.querySelector(
                '#workskin'
            );

        if (!workskin) {
            return;
        }


        /*
         * 避免创建多个 observer。
         */

        if (workObserver) {
            workObserver.disconnect();
        }


        workObserver =
            new MutationObserver(
                () => {

                    clearTimeout(
                        cleanTimer
                    );


                    /*
                     * debounce
                     *
                     * 避免一次 DOM 大量变化时重复运行几十次。
                     */

                    cleanTimer =
                        setTimeout(
                            cleanExtraBreaks,
                            120
                        );
                }
            );


        workObserver.observe(
            workskin,
            {
                childList: true,
                subtree: true
            }
        );
    }


    // ============================================================
    // 8. AO3 阅读样式
    // ============================================================

    function applyStyles() {
        const settings =
            getSettings();


        const styleId =
            'ao3-site-wizard-custom-style';

        let styleEl =
            document.getElementById(
                styleId
            );


        if (!styleEl) {
            styleEl =
                document.createElement(
                    'style'
                );

            styleEl.id =
                styleId;

            (
                document.head ||
                document.documentElement
            ).appendChild(
                styleEl
            );
        }


        // --------------------------------------------------------
        // 总开关关闭
        // --------------------------------------------------------

        if (!settings.enabled) {
            styleEl.textContent = '';
            return;
        }


        // --------------------------------------------------------
        // CSS
        // --------------------------------------------------------

        const cssRules = `

            /* ====================================================
               全局字体
               ==================================================== */

            ${settings.siteFont ? `

            body,
            body *:not(code):not(pre):not(.icon) {
                font-family:
                    ${settings.siteFont}
                    !important;
            }

            ` : ''}


            /* ====================================================
               作品正文
               ==================================================== */

            #workskin,
            #workskin .userstuff,
            #workskin .userstuff p,
            #workskin .userstuff blockquote {

                ${settings.workFont ? `
                font-family:
                    ${settings.workFont}
                    !important;
                ` : ''}

                ${settings.fontSize ? `
                font-size:
                    ${settings.fontSize}
                    !important;
                ` : ''}

                ${settings.lineHeight ? `
                line-height:
                    ${settings.lineHeight}
                    !important;
                ` : ''}
            }


            /* ====================================================
               段落
               ==================================================== */

            #workskin .userstuff p {

                ${settings.letterSpacing ? `
                letter-spacing:
                    ${settings.letterSpacing}
                    !important;
                ` : ''}

                ${settings.paragraphSpacing ? `
                margin-bottom:
                    ${settings.paragraphSpacing}
                    !important;
                ` : ''}

                text-indent:
                    ${settings.enableIndent
                        ? '2em'
                        : '0em'}
                    !important;

                ${settings.justifyText ? `
                text-align:
                    justify
                    !important;
                ` : ''}
            }


            /* ====================================================
               阅读版心
               ==================================================== */

            #workskin .userstuff {

                ${settings.maxWidth ? `
                max-width:
                    ${settings.maxWidth}
                    !important;
                ` : ''}

                margin-left:
                    auto
                    !important;

                margin-right:
                    auto
                    !important;
            }


            /* ====================================================
               高对比度模式
               ==================================================== */

            ${settings.highContrast ? `

            body,
            #outer,
            #inner,
            #workskin,
            #workskin .userstuff,
            #workskin .userstuff * {

                color:
                    #000000
                    !important;

                background-color:
                    #ffffff
                    !important;
            }

            ` : ''}


            /* ====================================================
               隐藏 Notes
               ==================================================== */

            ${settings.hideNotes ? `

            #workskin .notes,
            #workskin .end.notes {
                display:
                    none
                    !important;
            }

            ` : ''}
        `;


        styleEl.textContent =
            cssRules;


        cleanExtraBreaks();
    }


