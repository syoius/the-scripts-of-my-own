// ==UserScript==
// @name         AO3: Site Wizard (with LXGW WenKai Screen CDN) - Personal Edition
// @namespace    http://tampermonkey.net/
// @version      1.6.1
// @description  Customize AO3 work and site styles with LXGW WenKai Screen online font, seamlessly sharing the Userscripts navbar menu with other scripts.
// @author       BlackBatCat (Modified)
// @match        *://archiveofourown.org/*
// @match        *://*.archiveofourown.org/*
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    // 1. 修复：使用 @latest 动态解析最新版本，解决 1.3.0 版本无法找到的问题
    const cdnFontCss = `@import url('https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-web@latest/style.css');`;
    GM_addStyle(cdnFontCss);

    // 默认配置（字号 110%，首行缩进开关）
    const DEFAULT_SETTINGS = {
        enabled: true,
        siteFont: '"LXGW WenKai GB Screen", "LXGW WenKai Screen", serif',
        workFont: '"LXGW WenKai GB Screen", "LXGW WenKai Screen", serif',
        fontSize: '110%',
        lineHeight: '1.7',
        maxWidth: '42em',
        letterSpacing: '0.02em',
        paragraphSpacing: '0.8em',
        enableIndent: false, // 缩进开关：开 = 2em, 关 = 0em
        justifyText: true,
        highContrast: true,
        hideNotes: false
    };

    // 读取或初始化用户设置
    function getSettings() {
        const saved = localStorage.getItem('ao3_site_wizard_settings');
        if (!saved) return DEFAULT_SETTINGS;
        try {
            return { ...DEFAULT_SETTINGS, ...JSON.parse(saved) };
        } catch (e) {
            return DEFAULT_SETTINGS;
        }
    }

    function saveSettings(settings) {
        localStorage.setItem('ao3_site_wizard_settings', JSON.stringify(settings));
    }

    // 2. 生成并注入 AO3 样式表
    function applyStyles() {
        const settings = getSettings();
        if (!settings.enabled) {
            const oldStyle = document.getElementById('ao3-site-wizard-custom-style');
            if (oldStyle) oldStyle.textContent = '';
            return;
        }

        const styleId = 'ao3-site-wizard-custom-style';
        let styleEl = document.getElementById(styleId);
        if (!styleEl) {
            styleEl = document.createElement('style');
            styleEl.id = styleId;
            (document.head || document.documentElement).appendChild(styleEl);
        }

        const cssRules = `
            /* 1. 全局站点字体设置 */
            ${settings.siteFont ? `
            body, body *:not(code):not(pre):not(.icon) {
                font-family: ${settings.siteFont} !important;
            }` : ''}

            /* 2. 正文/作品区（Workskin）基础设置 */
            #workskin,
            #workskin .userstuff,
            #workskin .userstuff p,
            #workskin .userstuff blockquote {
                ${settings.workFont ? `font-family: ${settings.workFont} !important;` : ''}
                ${settings.fontSize ? `font-size: ${settings.fontSize} !important;` : ''}
                ${settings.lineHeight ? `line-height: ${settings.lineHeight} !important;` : ''}
            }

            /* 3. 段落细节微调 */
            #workskin .userstuff p {
                ${settings.letterSpacing ? `letter-spacing: ${settings.letterSpacing} !important;` : ''}
                ${settings.paragraphSpacing ? `margin-bottom: ${settings.paragraphSpacing} !important;` : ''}
                text-indent: ${settings.enableIndent ? '2em' : '0em'} !important;
                ${settings.justifyText ? `text-align: justify !important;` : ''}
            }

            /* 4. 阅读版心宽度限制 */
            #workskin .userstuff {
                ${settings.maxWidth ? `max-width: ${settings.maxWidth} !important;` : ''}
                margin-left: auto !important;
                margin-right: auto !important;
            }

            /* 5. 纯黑高对比度（适合墨水屏） */
            ${settings.highContrast ? `
            #workskin, #workskin .userstuff, #workskin .userstuff p, #workskin .userstuff * {
                color: #000000 !important;
            }` : ''}

            /* 6. 隐藏作者前言/后记 */
            ${settings.hideNotes ? `
            #workskin .notes, #workskin .end.notes {
                display: none !important;
            }` : ''}
        `;

        styleEl.textContent = cssRules;
    }

    // 3. 构建控制面板 UI 及原作者兼容的 Userscripts 顶级菜单共享逻辑
    function createUI() {
        if (document.getElementById('ao3-wizard-ui')) return;

        const settings = getSettings();

        // 原作者全家桶通用的 Navbar 寻找与挂载逻辑
        const primaryNav = document.querySelector('#header ul.primary');
        if (primaryNav) {
            // 匹配原作者可能使用的各种 class 和结构模式
            let userscriptMenu = primaryNav.querySelector('li.userscripts, li.userscript, li.dropdown[menu="userscripts"]');

            // 如果没通过 class 找到，通过菜单文本内容做兜底匹配
            if (!userscriptMenu) {
                const lis = primaryNav.querySelectorAll('li.dropdown');
                for (let li of lis) {
                    const a = li.querySelector('a');
                    if (a && a.textContent.trim().toLowerCase() === 'userscripts') {
                        userscriptMenu = li;
                        break;
                    }
                }
            }

            let menuList = null;

            if (userscriptMenu) {
                // 如果原作者的菜单已经存在，直接获取其内部的下拉列表 ul
                menuList = userscriptMenu.querySelector('ul');
            } else {
                // 如果当前脚本是最先加载的，按照原作者标准结构创建顶级菜单
                userscriptMenu = document.createElement('li');
                userscriptMenu.className = 'dropdown userscripts';
                userscriptMenu.innerHTML = `
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">Userscripts</a>
                    <ul class="menu dropdown-menu" role="menu"></ul>
                `;
                primaryNav.appendChild(userscriptMenu);
                menuList = userscriptMenu.querySelector('ul');
            }

            // 在共享的 Userscripts 菜单下追加本脚本的入口项
            if (menuList && !document.getElementById('ao3-wizard-nav-link')) {
                const menuItem = document.createElement('li');
                menuItem.innerHTML = `<a id="ao3-wizard-nav-link" href="#">Site Wizard</a>`;
                menuList.appendChild(menuItem);
            }
        }

        // 创建控制面板外壳
        const container = document.createElement('div');
        container.id = 'ao3-wizard-ui';
        container.style.cssText = `
            position: fixed;
            top: 15%;
            right: 20px;
            z-index: 999999;
            background: #fff;
            border: 2px solid #900;
            padding: 14px 16px;
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.25);
            font-size: 13px;
            color: #333;
            width: 290px;
            max-height: 80vh;
            overflow-y: auto;
            display: none;
            box-sizing: border-box;
        `;

        container.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #ddd; padding-bottom:6px; margin-bottom:10px;">
                <h3 style="margin:0; font-size:15px; color:#900;">AO3 Site Wizard</h3>
                <span id="wiz-close" style="cursor:pointer; font-weight:bold; color:#888; font-size:16px;">✕</span>
            </div>

            <label style="display:block; margin-bottom:8px; font-weight:bold;">
                <input type="checkbox" id="wiz-enable" ${settings.enabled ? 'checked' : ''}> 启用自定义样式
            </label>

            <hr style="border:none; border-top:1px dashed #ccc; margin:8px 0;">

            <label style="display:block; margin-bottom:6px;">
                正文字体 (Work Font):
                <input type="text" id="wiz-work-font" value='${settings.workFont}' style="width:100%; box-sizing:border-box; margin-top:2px;">
            </label>

            <div style="display:flex; gap:8px; margin-bottom:6px;">
                <label style="flex:1;">
                    字号:
                    <input type="text" id="wiz-font-size" value='${settings.fontSize}' style="width:100%; box-sizing:border-box; margin-top:2px;">
                </label>
                <label style="flex:1;">
                    行高:
                    <input type="text" id="wiz-line-height" value='${settings.lineHeight}' style="width:100%; box-sizing:border-box; margin-top:2px;">
                </label>
            </div>

            <div style="display:flex; gap:8px; margin-bottom:6px;">
                <label style="flex:1;">
                    字间距:
                    <input type="text" id="wiz-letter-spacing" value='${settings.letterSpacing}' style="width:100%; box-sizing:border-box; margin-top:2px;">
                </label>
                <label style="flex:1;">
                    段间距:
                    <input type="text" id="wiz-para-spacing" value='${settings.paragraphSpacing}' style="width:100%; box-sizing:border-box; margin-top:2px;">
                </label>
            </div>

            <div style="margin-bottom:8px;">
                <label style="display:block;">
                    最大版宽:
                    <input type="text" id="wiz-max-width" value='${settings.maxWidth}' style="width:100%; box-sizing:border-box; margin-top:2px;">
                </label>
            </div>

            <hr style="border:none; border-top:1px dashed #ccc; margin:8px 0;">

            <label style="display:block; margin-bottom:4px;">
                <input type="checkbox" id="wiz-indent" ${settings.enableIndent ? 'checked' : ''}> 首行缩进 2 个中文字符
            </label>
            <label style="display:block; margin-bottom:4px;">
                <input type="checkbox" id="wiz-justify" ${settings.justifyText ? 'checked' : ''}> 正文两端对齐
            </label>
            <label style="display:block; margin-bottom:4px;">
                <input type="checkbox" id="wiz-contrast" ${settings.highContrast ? 'checked' : ''}> 强制纯黑高对比文字
            </label>
            <label style="display:block; margin-bottom:12px;">
                <input type="checkbox" id="wiz-hide-notes" ${settings.hideNotes ? 'checked' : ''}> 隐藏作者前言/后记 (Notes)
            </label>

            <div style="text-align:right;">
                <button id="wiz-save" style="background:#900; color:#fff; border:none; padding:6px 14px; border-radius:4px; cursor:pointer; font-weight:bold;">保存并生效</button>
            </div>
        `;

        document.body.appendChild(container);

        // 显示/隐藏面板逻辑
        const toggleUI = (e) => {
            if (e) e.preventDefault();
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        };

        // 事件绑定：菜单项点击 & 关闭按钮
        const navLink = document.getElementById('ao3-wizard-nav-link');
        if (navLink) navLink.addEventListener('click', toggleUI);

        document.getElementById('wiz-close').addEventListener('click', toggleUI);

        // 快捷键: Shift + Alt + W
        document.addEventListener('keydown', (e) => {
            if (e.shiftKey && e.altKey && e.code === 'KeyW') {
                toggleUI();
            }
        });

        // 保存逻辑
        document.getElementById('wiz-save').addEventListener('click', () => {
            const newSettings = {
                enabled: document.getElementById('wiz-enable').checked,
                siteFont: settings.siteFont,
                workFont: document.getElementById('wiz-work-font').value,
                fontSize: document.getElementById('wiz-font-size').value,
                lineHeight: document.getElementById('wiz-line-height').value,
                letterSpacing: document.getElementById('wiz-letter-spacing').value,
                paragraphSpacing: document.getElementById('wiz-para-spacing').value,
                maxWidth: document.getElementById('wiz-max-width').value,
                enableIndent: document.getElementById('wiz-indent').checked,
                justifyText: document.getElementById('wiz-justify').checked,
                highContrast: document.getElementById('wiz-contrast').checked,
                hideNotes: document.getElementById('wiz-hide-notes').checked
            };
            saveSettings(newSettings);
            applyStyles();
            container.style.display = 'none';
        });
    }

    // 初始化运行
    applyStyles();
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createUI);
    } else {
        createUI();
    }
})();
